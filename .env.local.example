# --- School / branding ------------------------------------------------------
NEXT_PUBLIC_SCHOOL_NAME="RISE School of Accountancy"
NEXT_PUBLIC_TEACHER_EMAIL="alipervaiz.ca269@gmail.com"
NEXT_PUBLIC_TEACHER_NAME="Ali Pervaiz"

# --- Free database: Google Sheets via a Google Apps Script Web App ----------
# Deploy google-apps-script/Code.gs as a Web App (Execute as: Me, Who has
# access: Anyone) and paste its /exec URL here. Only ever called from this
# app's server code (Server Actions/Components) — never from the browser —
# despite the NEXT_PUBLIC_ prefix, which just matches the project spec.
NEXT_PUBLIC_GOOGLE_SCRIPT_URL="https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec"

# Shared secret for teacher-only writes (create/update/publish/archive a
# mock). Run the `setup` function once in the Apps Script editor — it prints
# this value to the execution log. Never exposed to the browser.
GOOGLE_SCRIPT_TEACHER_TOKEN="paste-the-TEACHER_TOKEN-logged-by-setup()"

# --- Auth --------------------------------------------------------------------
# The one faculty account's password. Students need no password — they sign
# in with Name + RISE/ACCA Student ID + Batch (see README for the tradeoff).
TEACHER_PASSWORD="choose-a-strong-password"

# Signs the session cookie (HMAC-SHA256) — any long random string. Generate
# one with: openssl rand -hex 32
SESSION_SECRET="replace-with-a-long-random-string"
