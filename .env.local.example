# --- Supabase --------------------------------------------------------------
# Project Settings -> API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Service role key — SERVER ONLY, never exposed to the browser.
# Used to strip answer keys before sending questions to students and to
# grade submissions server-side.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Anthropic (Claude) ------------------------------------------------------
# Used to turn uploaded PDF mock papers into structured MCQs.
ANTHROPIC_API_KEY=sk-ant-...

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_SCHOOL_NAME="RISE School of Accountancy"
# Domain used to synthesize internal auth emails from ACCA/RISE Student IDs
# (students log in with an ID, not an email — see src/lib/auth.ts)
STUDENT_AUTH_EMAIL_DOMAIN=students.rise.local

# --- Seeding (scripts/seed.ts) ------------------------------------------------
